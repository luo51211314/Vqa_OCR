# Ignore all __pycache__ directories at any level
__pycache__/
*/__pycache__/

# Ignore json, txt, png, csv files, but not requirements files
*.json
*.txt
*.png
*.csv
!config.json
!requirements*.txt

# Ignore log files
*.log

# Ignore results folder
results/

# Ignore data folder
data/

# Experiment / evaluation output directories
/ablation/
/experiment/
/experiment_no_clustering/
/experiments_no_random/
/experiments_time/
/quick_test/
/pipeline_test/
/strategy_comparison_visualizations/

# Training logs
train_log*

# Python / OS extras
*.pyc
*.pyo
*.egg-info/
.DS_Store

# Local artifacts and unpublished manuscript
/results_repro/
/sn-article.tex
/.trae/
/.vscode/
/.idea/
.env
.env.*
*.parquet
*.arrow
*.safetensors
*.pt
*.pth
*.ckpt
*.tar
*.tar.gz
*.zip
# Independent training and upstream non-runtime assets
/finetune/
/models/llava/docs/
/models/llava/images/
/models/llava/.github/
/models/llava/.devcontainer/
/models/llava/llava/serve/examples/
